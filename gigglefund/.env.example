# Deployer wallet (NEVER commit real keys)
DEPLOYER_PRIVATE_KEY=

# BNB Chain RPC endpoints (optional — defaults are public nodes)
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.binance.org:8545
BSC_MAINNET_RPC=https://bsc-dataseed.binance.org

# BscScan API key for contract verification
BSCSCAN_API_KEY=

# Charity wallet that receives tip donations (multisig recommended)
CHARITY_WALLET=

# Web app — WalletConnect project id from https://cloud.walletconnect.com
VITE_WALLETCONNECT_PROJECT_ID=

# Filled automatically after deploy:testnet or deploy:mainnet
VITE_GIGL_TOKEN_ADDRESS=
VITE_LAUGH_TIP_ADDRESS=
VITE_CHARITY_VAULT_ADDRESS=
